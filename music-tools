SCRIPTS = {"art": "fix_album_art.py", "artists": "find_artist_art.py", "lyrics": "find_lyrics.py",
          "tags": "fix_misidentified_tags.py", "duplicates": "find_duplicates.py", "stats": "library_stats.py",
          "layout": "library_layout.py",
          "organize": "organize_music.py", "all": "run_all.py"}


def run_script(name: str, args: list) -> int:
    return run_tool(name, args)  # the script handles Ctrl-C itself and stops safely


def parse_value(text: str, example):
    """Turn command-line text into the same type as the default value."""
    if isinstance(example, bool):
        low = text.lower()
        if low in ("true", "yes", "on", "1"):
            return True
        if low in ("false", "no", "off", "0"):
            return False
        sys.exit(f"Expected true or false, got {text!r}")
    if isinstance(example, (int, float)):
        try:
            return int(text) if isinstance(example, int) and "." not in text else float(text)
        except ValueError:
            sys.exit(f"Expected a number, got {text!r}")
    if isinstance(example, list):
        return [p.strip() for p in text.split(",") if p.strip()]
    return text


def split_key(key: str):
    parts = key.split(".")
    if len(parts) == 1 and parts[0] in DEFAULTS and not isinstance(DEFAULTS[parts[0]], dict):
        return None, parts[0]
    if len(parts) == 2 and isinstance(DEFAULTS.get(parts[0]), dict) and parts[1] in DEFAULTS[parts[0]]:
        return parts[0], parts[1]
    keys = [k for k, v in DEFAULTS.items() if not isinstance(v, dict)]
    keys += [f"{s}.{k}" for s, v in DEFAULTS.items() if isinstance(v, dict) for k in v]
    sys.exit(f"Unknown setting {key!r}. Settings: {', '.join(keys)}")


def folder_entry(text: str, music_dir: str) -> str:
    """Store existing paths as full paths; otherwise keep them relative to music_dir."""
    p = Path(text).expanduser()
    if p.is_dir():
        return str(p.resolve())
    if p.is_absolute():
        print(f"  note: {p} doesn't exist (yet) — added anyway")
        return str(p)
    if not resolve(text, music_dir).is_dir():
        print(f"  note: {resolve(text, music_dir)} doesn't exist (yet) — added anyway")
    return text


def show_where(cfg: dict, path: Path):
    music_dir = str(Path(cfg["music_dir"]).expanduser())
    print(f"Config file:  {path}{'' if path.is_file() else '  (not created yet, using defaults)'}")
    print(f"Music folder: {music_dir}{'' if Path(music_dir).is_dir() else '  (not found!)'}")
    print("Art folders:")
    for f in cfg["album_art"]["folders"]:
        full = resolve(f, music_dir)
        print(f"  {f}" + ("" if str(full) == f else f"  ->  {full}") + ("" if full.is_dir() else "  (not found!)"))


def main(argv: list) -> int:
    config = None
    if len(argv) >= 2 and argv[0] == "--config":
        config, argv = argv[1], argv[2:]
    extra = ["--config", config] if config else []
    if not argv or argv[0] == "menu":
        if not sys.stdin.isatty():
            print(HELP)
            return 0
        return run_menu(config, HELP)
    if argv[0] in ("help", "-h", "--help"):
        if len(argv) > 1 and argv[1] in SCRIPTS:
            return run_script(argv[1], ["--help"])
        print(HELP)
        return 0

    cmd, args = argv[0], argv[1:]
    if cmd in SCRIPTS:
        return run_script(cmd, extra + args)
    if cmd == "missing":
        return run_script("art", extra + ["--list-missing", *args])
    if cmd == "retry":
        return run_script("art", extra + ["--retry", *args])

    path = config_path(config)
    cfg = read_raw_config(path)
    music_dir = str(Path(cfg["music_dir"]).expanduser())
    folders = cfg["album_art"]["folders"]

    if cmd == "where":
        show_where(cfg, path)
        return 0

    if cmd == "dir":
        if not args:
            print(music_dir)
            return 0
        new = Path(args[0]).expanduser()
        if not new.is_dir():
            print(f"  note: {new} doesn't exist (yet) — saved anyway")
        cfg["music_dir"] = str(new.resolve() if new.is_dir() else new)
        save_config(cfg, path)
        show_where(cfg, path)
        return 0

    if cmd == "folders":
        action = args[0] if args else "list"
        targets = args[1:]
        if action in ("list", "ls"):
            show_where(cfg, path)
            return 0
        if action not in ("use", "set", "add", "remove", "rm") or not targets:
            sys.exit(f"Usage: {PROG} folders [use|add|remove] PATH [PATH..]")
        if action in ("use", "set"):
            cfg["album_art"]["folders"] = [folder_entry(t, music_dir) for t in targets]
        elif action == "add":
            for t in targets:
                entry = folder_entry(t, music_dir)
                if entry not in folders:
                    folders.append(entry)
        else:
            for t in targets:
                matches = [f for f in folders if f == t or resolve(f, music_dir) == resolve(t, music_dir)
                           or Path(f) == Path(t).expanduser().resolve()]
                if not matches:
                    sys.exit(f"{t!r} isn't in the list. Current folders: {', '.join(folders)}")
                for m in matches:
                    folders.remove(m)
        save_config(cfg, path)
        show_where(cfg, path)
        return 0

    if cmd == "settings":
        print(f"# {path}")
        for k, v in cfg.items():
            if not isinstance(v, dict):
                print(f"{k} = {v!r}")
        for section, values in cfg.items():
            if isinstance(values, dict):
                print(f"\n[{section}]")
                for k, v in values.items():
                    print(f"{section}.{k} = {v!r}")
        return 0

    if cmd in ("set", "reset"):
        if (cmd == "set" and len(args) != 2) or (cmd == "reset" and len(args) != 1):
            sys.exit(f"Usage: {PROG} set KEY VALUE   or   {PROG} reset KEY")
        section, key = split_key(args[0])
        default = DEFAULTS[section][key] if section else DEFAULTS[key]
        value = default if cmd == "reset" else parse_value(args[1], default)
        (cfg[section] if section else cfg)[key] = value
        save_config(cfg, path)
        print(f"{args[0]} = {value!r}")
        return 0

    if cmd == "edit":
        if not path.is_file():
            save_config(cfg, path)
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
        if editor:
            return subprocess.call([*editor.split(), str(path)])
        return subprocess.call(["open", "-t", str(path)] if sys.platform == "darwin" else ["xdg-open", str(path)])

    print(f"Unknown command {cmd!r}. Run '{PROG} help' for the list.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
